# React: leave blank locally so Vite proxies /api to port 8000.
# Production example: https://your-api.onrender.com (no trailing /api).
VITE_API_BASE_URL=
# Backend: set on your hosting service, never as a VITE_ variable.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: public GitHub API works without a token, with a lower rate limit.
GITHUB_TOKEN=
